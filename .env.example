# GPlanSiS|PDIN — modelo de variáveis. Copie para .env e preencha com SEUS valores.
# Nunca versione o .env.

# Senha do PostgreSQL (docker-compose.prod.yml exige; compose.yaml local usa pdin_demo_local se vazio)
PDIN_DB_PASSWORD=troque-esta-senha

# URL do banco usada pela API quando roda fora do Docker
PDIN_DATABASE_URL=postgresql://pdin_owner:troque-esta-senha@127.0.0.1:5437/pdin_demo

# Administrador master (único, sempre ativo). A senha é provisória: troca obrigatória no 1º acesso.
PDIN_MASTER_EMAIL=admin@exemplo.com
PDIN_MASTER_NAME=Administrador
PDIN_MASTER_PASSWORD=SenhaProvisoria123

# Token do gateway de telemetria (Authorization: Bearer ... em POST /api/projects/{id}/telemetry)
PDIN_GATEWAY_TOKEN=gere-um-token-aleatorio
